{
  "name": "liberia360",
  "private": true,
  "version": "0.1.0",
  "description": "LIBERIA360 — Everything Liberia. One Place. Monorepo (api + web).",
  "workspaces": [
    "api",
    "web",
    "packages/shared-types"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "test:api": "npm run test --workspace=api",
    "test:web": "npm run test --workspace=web",
    "lint:api": "npm run lint --workspace=api",
    "lint:web": "npm run lint --workspace=web",
    "seed:api": "npm run seed --workspace=api",
    "migrate:api": "npm run migration:run --workspace=api",
    "build": "npm run build:api",
    "start": "npm run migrate:api && npm run start:prod --workspace=api"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "js-yaml": "^5.2.2"
  }
}

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=liberia360
DB_PASSWORD=liberia360
DB_DATABASE=liberia360
# Set to "true" only for local dev bootstrapping — migrations should own schema changes otherwise.
DB_SYNCHRONIZE=false
# Set to "true" when pointing DB_HOST at a free managed Postgres (Neon,
# Render, Heroku, ...) instead of your own server — those require an
# encrypted connection and refuse to connect without this.
DB_SSL=false

# Auth (Phase 2) — generate a real secret for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Two-factor authentication — AES-256-GCM key (32 bytes, hex) that TOTP
# secrets are encrypted with at rest (src/auth/two-factor-crypto.ts).
# Generate a real one for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=deaddeaddeaddeaddeaddeaddeaddeaddeaddeaddeaddeaddeaddeaddeaddead

# Web Push (Phase 2) — generate a VAPID keypair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@example.com

# Public web app origin — used to build links that go *in* an email
# (verify-email, reset-password). The API has no view layer of its own.
WEB_APP_URL=http://localhost:3000

# Transactional email (password reset, email verification) — SMTP.
# Unset in local dev on purpose: MailService logs the email body (with the
# link) instead of sending it, so you can test these flows without a real
# inbox. Set all three for anything beyond local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=LIBERIA360 <no-reply@liberia360.example>

# File storage for uploaded photos (src/uploads). "local" (default) writes
# to a folder on this instance — dev/demo only, doesn't survive a
# redeploy or work across multiple instances. Set STORAGE_DRIVER=s3 for
# anything beyond local dev — any S3-compatible provider works (AWS S3,
# Cloudflare R2, DigitalOcean Spaces, MinIO, ...).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for a non-AWS S3-compatible endpoint (R2, MinIO, ...).
S3_ENDPOINT=
# Public base URL uploaded files are served from once in S3 — your CDN in
# front of the bucket, the bucket's own public URL, or the provider's
# endpoint, depending on setup. e.g. https://cdn.example.com or
# https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL_BASE=

# Crash reporting (src/error-tracking). Unset by default — errors are only
# logged locally (console/Nest's logger). Set to a real Sentry DSN for
# anything beyond local dev.
SENTRY_DSN=

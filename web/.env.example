# Server-only upstream. Browser requests use the same-origin /api proxy and
# never receive the infrastructure hostname in the JavaScript bundle.
API_ORIGIN=http://localhost:3001
# Existing deployments may temporarily keep NEXT_PUBLIC_API_URL instead;
# both a bare origin and the legacy https://api.example.com/api/v1 form are
# accepted. Prefer API_ORIGIN for new deployments because it stays server-only.
# Managed-platform blueprints may instead provide API_HOST and API_PORT; the
# Render Blueprint does this automatically for its private service network.

# Canonical site origin for SEO structured data (schema.org JSON-LD's `url`
# fields need an absolute URL) — set this to the real production domain
# once there is one. Falls back to a placeholder if unset.
NEXT_PUBLIC_SITE_URL=https://liberia360.example

# Client-side crash reporting (src/lib/error-reporting.ts). Unset by
# default on purpose: errors are only logged to the browser console
# locally. Set to a real Sentry DSN for anything beyond local dev.
NEXT_PUBLIC_SENTRY_DSN=

# Required for every map in the app (Explore, trip maps, the pharmacy map,
# place/event mini-maps, and the admin location picker's search box) —
# Google Cloud Console → enable "Maps JavaScript API" and "Places API" on a
# project with billing enabled → Credentials → create an API key. It's
# meant for client-side use; restrict it to your domain(s) there
# (HTTP referrers). See DEPLOYMENT.md for the full walkthrough.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Custom-styled "Advanced Marker" pins (every map's colored/numbered dots)
# require a Map ID — same Google Cloud project → Google Maps Platform → Map
# Management → Create Map ID (no additional cost). Falls back to Google's
# own DEMO_MAP_ID placeholder when unset, which renders a visible
# "for development purposes only" watermark — fine for local dev, not for
# production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
